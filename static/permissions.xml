    <DirectoryRef Id="APPLICATIONROOTDIRECTORY">
      <Component Id="ApplicationRootDirectoryPermissions" Guid="12623B62-745F-411B-8550-BA5F55398C28" Win64="{{Win64YesNo}}">
        <CreateFolder>
          <!--
            The core Permission element (MSI LockPermissions table) is used
            rather than util:PermissionEx: PermissionEx only adds ACEs, so any
            pre-existing or inherited write grant on a user-chosen install
            directory survives. Permission replaces the ACL outright and drops
            inheritance, which is the point of this component.
          -->
          <Permission User="Administrators" GenericAll="yes"/>
          <Permission User="SYSTEM" GenericAll="yes"/>
          <Permission User="Everyone" GenericRead="yes" GenericExecute="yes"/>
        </CreateFolder>
      </Component>
    </DirectoryRef>
